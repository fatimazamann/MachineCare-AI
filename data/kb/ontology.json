      "hazardous_fluid": true,
      "fluid": "flammable solvent",
      "production_line": "Coating line",
      "location": "Solvent tank farm"
    },
    "M-120": {
      "class": "InductionMotor",
      "name": "Drive motor for P-101 (DOL)",
      "power_kw": 37,
