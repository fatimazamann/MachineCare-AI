      "product_variant": "M",
      "production_line": "Machining",
      "location": "Machine shop"
    },
    "GEN-PUMP": {
      "class": "CentrifugalPump",
      "name": "Generic centrifugal pump",
      "generic": true
    },
    "GEN-MOTOR": {
      "class": "InductionMotor",
      "name": "Generic induction motor",
      "generic": true
    },
    "GEN-CNC": {
      "class": "CNCMillingMachine",
      "name": "Generic CNC milling machine",
      "generic": true
    },
    "APU-01": {
      "class": "AirCompressor",
      "name": "Metro train air production unit",
      "criticality": "A",
      "has_standby": false,
      "production_line": "Metro fleet",
      "location": "Train underframe"
    },
    "GEN-APU": {
      "class": "AirCompressor",
      "name": "Generic train air compressor",
      "generic": true
    }
  }
}
